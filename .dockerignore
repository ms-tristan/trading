# Keep the build context small and reproducible: only sources, tests,
# configuration and documentation are copied into the image.
.git
.gitignore
.venv
.uv-cache
data
reports
htmlcov
coverage.xml
.coverage
__pycache__
*.pyc
*.pyo
.pytest_cache
.mypy_cache
.ruff_cache
.scratch
# ---- secrets: never bake a credential into an image layer ----
.env
.env.*
!.env.example
deploy/.env
*.pem
*.key
*.db
*.db-wal
*.db-shm
